SPRING_PROFILES_ACTIVE=local
POSTGRES_DB=mednav
POSTGRES_USER=mednav
POSTGRES_PASSWORD=mednav_local
POSTGRES_URL=jdbc:postgresql://localhost:5432/mednav
REDIS_HOST=localhost
REDIS_PORT=6379
BCRYPT_STRENGTH=12

# Leave blank for the local Stub Agent.
OPENAI_API_KEY=
OPENAI_BASE_URL=
PRIMARY_MODEL=
SUMMARY_MODEL=
VERIFICATION_MODEL=
SEMANTIC_VERIFICATION_ENABLED=true
SEMANTIC_VERIFICATION_THRESHOLD=65

MEMORY_CACHE=redis
MEMORY_USER_CACHE_TTL=10m
SESSION_IDLE_TIMEOUT=10m
SESSION_IDLE_SCAN_MS=60000

GOOGLE_MAPS_API_KEY=
MAPS_MODE=stub
GOOGLE_ROUTE_BATCH_SIZE=100
GOOGLE_ROUTE_MAX_CONCURRENCY=3
GOOGLE_ROUTE_CACHE_TTL=10m
GOOGLE_ROUTE_PARAMETERS_VERSION=route-v1
CMS_DATA_DIR=../dataset
CMS_REFRESH_ENABLED=true
CMS_IMPORT_LOCAL_ON_STARTUP=false
CMS_BATCH_SIZE=1000
CMS_MIN_AFFILIATION_JOIN_RATE=0.10
