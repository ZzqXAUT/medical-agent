#!/usr/bin/env sh
set -eu

MAVEN_VERSION=3.9.11
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_HOME="$SCRIPT_DIR/.mvn/apache-maven-$MAVEN_VERSION"
MAVEN_ARCHIVE="$SCRIPT_DIR/.mvn/apache-maven-$MAVEN_VERSION-bin.tar.gz"
MAVEN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.tar.gz"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  if [ ! -f "$MAVEN_ARCHIVE" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "$MAVEN_URL" -o "$MAVEN_ARCHIVE"
    else
      wget -q "$MAVEN_URL" -O "$MAVEN_ARCHIVE"
    fi
  fi
  tar -xzf "$MAVEN_ARCHIVE" -C "$SCRIPT_DIR/.mvn"
fi

exec "$MAVEN_HOME/bin/mvn" -Dmaven.repo.local="$SCRIPT_DIR/.mvn/repository" "$@"
