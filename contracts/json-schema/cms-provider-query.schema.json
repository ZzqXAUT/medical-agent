{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mednav.local/schemas/cms-provider-query-v1.json",
  "title": "MedNav CMS hospital and doctor facts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["hospital", "doctors"],
  "properties": {
    "hospital": { "$ref": "#/$defs/hospital" },
    "doctors": {
      "type": "array",
      "items": { "$ref": "#/$defs/doctorCandidate" }
    }
  },
  "$defs": {
    "hospital": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "facilityId",
        "facilityName",
        "city",
        "state"
      ],
      "properties": {
        "snapshotId": { "type": "string", "format": "uuid" },
        "facilityId": { "type": "string", "pattern": "^[0-9A-Z]{6}$" },
        "facilityName": { "type": "string", "minLength": 1 },
        "address": { "type": ["string", "null"] },
        "city": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "zipCode": { "type": ["string", "null"] },
        "county": { "type": ["string", "null"] },
        "telephone": { "type": ["string", "null"] },
        "hospitalType": { "type": ["string", "null"] },
        "hospitalOwnership": { "type": ["string", "null"] },
        "emergencyServices": { "type": ["boolean", "null"] },
        "birthingFriendly": { "type": ["boolean", "null"] },
        "overallRating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "overallRatingFootnote": { "type": ["string", "null"] }
      }
    },
    "specialtyFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "normalizedName"],
      "properties": {
        "type": { "enum": ["PRIMARY", "SECONDARY"] },
        "name": { "type": "string", "minLength": 1 },
        "normalizedName": { "type": "string", "minLength": 1 }
      }
    },
    "doctorCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "facilityId",
        "npi",
        "firstName",
        "lastName",
        "facilityType",
        "matchedSpecialties"
      ],
      "properties": {
        "snapshotId": { "type": "string", "format": "uuid" },
        "facilityId": { "type": "string", "pattern": "^[0-9A-Z]{6}$" },
        "npi": { "type": "string", "pattern": "^[0-9]{10}$" },
        "firstName": { "type": "string", "minLength": 1 },
        "middleName": { "type": ["string", "null"] },
        "lastName": { "type": "string", "minLength": 1 },
        "suffix": { "type": ["string", "null"] },
        "credential": { "type": ["string", "null"] },
        "medicalSchool": { "type": ["string", "null"] },
        "graduationYear": { "type": ["integer", "null"], "minimum": 1800, "maximum": 2200 },
        "facilityType": { "type": "string", "minLength": 1 },
        "matchedSpecialties": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/specialtyFact" }
        }
      }
    }
  }
}
