{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mednav.local/schemas/cms-snapshot-v1.json",
  "title": "MedNav CMS snapshot import result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotId",
    "status",
    "sourceRows",
    "hospitals",
    "doctors",
    "specialties",
    "affiliations"
  ],
  "properties": {
    "snapshotId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Null only when another refresh owner holds the database lease."
    },
    "status": {
      "enum": ["ACTIVE", "NO_CHANGE", "LOCKED"]
    },
    "sourceRows": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "hospitals": { "type": "integer", "minimum": 0 },
    "doctors": { "type": "integer", "minimum": 0 },
    "specialties": { "type": "integer", "minimum": 0 },
    "affiliations": { "type": "integer", "minimum": 0 }
  }
}
