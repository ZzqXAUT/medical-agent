{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mednav.local/schemas/navigation-recommendation-v1.json",
  "title": "MedNav recommendation run response",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "conversationId", "contextVersion", "locationRevision", "clinicalRevision", "status"],
  "properties": {
    "taskId": { "type": "string", "format": "uuid" },
    "conversationId": { "type": "string", "format": "uuid" },
    "contextVersion": { "type": "integer", "minimum": 0 },
    "locationRevision": { "type": "integer", "minimum": 0 },
    "clinicalRevision": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["WAITING", "RUNNING", "READY", "READY_WITH_WARNINGS", "FAILED"] },
    "errorCode": { "type": "string" },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band", "policyVersion", "components"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "policyVersion": { "type": "string" },
        "components": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "routeMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distanceMiles", "durationMinutes"],
      "properties": {
        "distanceMiles": { "type": "number", "minimum": 0 },
        "durationMinutes": { "type": "integer", "minimum": 0 }
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npi", "name", "secondarySpecialties", "affiliationFacilityId", "recommendationReason", "recommendationReasons", "evidenceIds", "doctorConfidence"],
      "properties": {
        "npi": { "type": "string", "pattern": "^[0-9]{10}$" },
        "name": { "type": "string", "minLength": 1 },
        "credential": { "type": "string" },
        "primarySpecialty": { "type": "string" },
        "secondarySpecialties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "medicalSchool": { "type": "string" },
        "graduationYear": { "type": "integer", "minimum": 1800, "maximum": 2200 },
        "affiliationFacilityId": { "type": "string" },
        "recommendationReason": { "type": "string", "minLength": 1 },
        "recommendationReasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "doctorConfidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "hospital": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hospitalId", "name", "hospitalRankWithinDisease", "address", "recommendationReason", "diseaseHospitalMatchReasons", "doctors", "hospitalConfidence", "explanationConfidence", "evidenceIds", "limitations"],
      "properties": {
        "hospitalId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "hospitalRankWithinDisease": { "type": "integer", "minimum": 1, "maximum": 3 },
        "cmsRating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "address": { "type": "string" },
        "recommendationReason": { "type": "string", "minLength": 1 },
        "diseaseHospitalMatchReasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "drive": { "$ref": "#/$defs/routeMeasure" },
        "transit": { "$ref": "#/$defs/routeMeasure" },
        "walk": { "$ref": "#/$defs/routeMeasure" },
        "doctors": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/doctor" } },
        "hospitalConfidence": { "$ref": "#/$defs/confidence" },
        "explanationConfidence": { "$ref": "#/$defs/confidence" },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "disease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "diseaseRank", "recommendationReason", "diseaseConfidence", "hospitals", "evidenceIds", "limitations"],
      "properties": {
        "hypothesis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "severity", "estimatedProbability", "supportingFacts", "limitations"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "severity": { "enum": ["SEVERE", "MODERATE", "MILD"] },
            "estimatedProbability": { "type": "number", "minimum": 0, "maximum": 1 },
            "supportingFacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "diseaseRank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "recommendationReason": { "type": "string", "minLength": 1 },
        "diseaseConfidence": { "$ref": "#/$defs/confidence" },
        "hospitals": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/hospital" } },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "severity", "message", "repairAction", "semantic"],
      "properties": {
        "path": { "type": "string" },
        "code": { "type": "string" },
        "severity": { "enum": ["ERROR", "WARNING"] },
        "message": { "type": "string" },
        "repairAction": { "type": "string" },
        "semantic": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "source", "entityId", "fact"],
      "properties": {
        "evidenceId": { "type": "string" },
        "source": { "type": "string" },
        "snapshotId": { "type": "string" },
        "entityId": { "type": "string" },
        "fact": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "locationTaskId", "contextVersion", "locationRevision", "clinicalRevision", "cmsSnapshotId", "displayLanguage", "status", "overallConfidence", "verificationRounds", "semanticVerificationTriggered", "findings", "diseases", "evidence", "generatedAt"],
      "properties": {
        "conversationId": { "type": "string", "format": "uuid" },
        "locationTaskId": { "type": "string", "format": "uuid" },
        "contextVersion": { "type": "integer", "minimum": 0 },
        "locationRevision": { "type": "integer", "minimum": 1 },
        "clinicalRevision": { "type": "integer", "minimum": 1 },
        "cmsSnapshotId": { "type": "string" },
        "displayLanguage": { "enum": ["zh-CN", "en-US"] },
        "status": { "enum": ["READY", "READY_WITH_WARNINGS"] },
        "overallConfidence": { "$ref": "#/$defs/confidence" },
        "verificationRounds": { "type": "integer", "minimum": 0, "maximum": 3 },
        "semanticVerificationTriggered": { "type": "boolean" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "diseases": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/disease" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
